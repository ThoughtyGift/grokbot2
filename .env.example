# ── Grok Bot 2 backend config ──────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env or any *-key.txt file.

# Port the glue backend listens on (the frontend's CURSOR_API_BASE_URL points here)
PORT=8788

# Claude "brain" — your OpenClaw pool (subscription CLI, load-balanced, no API-token cost)
CLAUDE_POOL_URL=https://admin.halcion.vn/v1/claude
# Put your hal_xxx key in services/grokbot-backend/pool-key.txt (gitignored),
# or set it here (also gitignored via .env):
# CLAUDE_POOL_KEY=hal_xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=sonnet

# System prompt so the CLI (Claude Code by default) behaves as a chat assistant
CLAUDE_SYSTEM=Bạn là trợ lý trò chuyện thân thiện bên trong ứng dụng Grok Bot.

# ── The computer pane (VNC workspace) ──────────────────────────────────────
# Full noVNC PAGE url for your box — it must end in /vnc.html and carry whatever
# query the viewer needs (path=…/websockify, password, token). The app opens it as
# given and only adds autoconnect/resize/reconnect/sandInteractive.
# infra/vps/grok-box-up.sh brings a box up and prints the exact URL to paste here.
# Unset ⇒ the pane reports the box as off instead of showing a desktop.
# GROKBOT2_VNC_URL=https://your-host/flowvnc-grokbox/vnc.html?path=flowvnc-grokbox/websockify&autoconnect=true&password=CHANGE_ME

# Optional: the rest of the box descriptor (EnsureSandBox). Defaults point at this backend.
# GROKBOT2_GATEWAY_URL=http://localhost:8788/gw
# GROKBOT2_EXEC_URL=http://localhost:8788/exec
# GROKBOT2_FORK_VNC_URL=https://your-host

# ── Shell and file tools (run INSIDE the box, never on this machine) ───────
# Point these at infra/vps/exec-daemon.mjs running on your box. Deploy:
#   scp infra/vps/exec-daemon.mjs root@BOX:/opt/grok-exec-daemon.mjs
#   ssh root@BOX 'GROKBOT2_EXEC_TOKEN=<secret> systemd-run --unit=grok-exec --collect \
#       node /opt/grok-exec-daemon.mjs 1337 /root/workspace'
# then publish 127.0.0.1:1337 through nginx (keep the bearer token).
# Unset ⇒ run_terminal_command_v2 / read_file_v2 / list_dir_v2 / glob_file_search /
# ripgrep_raw_search are NOT offered to the model at all, rather than running locally.
# GROKBOT2_BOX_EXEC_URL=https://your-host/grok-exec
# GROKBOT2_EXEC_TOKEN=CHANGE_ME
# GROKBOT2_BOX_TIMEOUT_MS=90000

# ── Browser tools (the box's own Chrome, so the user watches it work in the pane) ──
# grok-box-up.sh starts Chrome with DevTools bound to 127.0.0.1:9223 ON THE BOX.
#
# NEVER publish a DevTools port through nginx — it is unauthenticated remote code
# execution. Tunnel it instead, then point this at the local end:
#   ssh -N -L 9223:127.0.0.1:9223 root@BOX
#
# Unset ⇒ the 16 browser_* tools are not offered to the model at all.
# GROKBOT2_BROWSER_CDP=http://127.0.0.1:9223

# ── S5 runtime process (Phase 4) ──────────────────────────────────────────
# `pnpm backend` starts @grokbot2/runtime on :8789 and points the BFF at it.
# Leave this unset in .env so e2e that spawn only the BFF keep an in-process pool.
# GROKBOT2_RUNTIME_URL=http://127.0.0.1:8789
# GROKBOT2_RUNTIME_PORT=8789

# ── S6 computer process (Phase 5) ─────────────────────────────────────────
# `pnpm backend` starts @grokbot2/computer on :8790 and points the BFF at it.
# Leave this unset in .env so e2e that spawn only the BFF keep in-process status/exec.
# A set URL that is down turns the pane off; it must not 500 sendPrompt.
# GROKBOT2_COMPUTER_URL=http://127.0.0.1:8790
# GROKBOT2_COMPUTER_PORT=8790

# ── S10/S11 ops process (Phase 6) ─────────────────────────────────────────
# `pnpm backend` starts @grokbot2/ops on :8791 and points the BFF at it.
# Leave this unset in .env so e2e that spawn only the BFF keep an in-process scheduler
# and BFF `/gw` Slack/GitHub webhooks. A set URL that is down must not 500 sendPrompt;
# cron must NOT fall back in-process (that would hide a dead ops).
# GROKBOT2_OPS_URL=http://127.0.0.1:8791
# GROKBOT2_OPS_PORT=8791

# ── Context compaction ────────────────────────────────────────────────────
# Long conversations were resent in full every turn: cost and latency grew with the
# conversation and it eventually exceeded the model's window. Older messages are now
# summarised into a handoff and only recent turns are sent verbatim.
# GROKBOT2_CONTEXT_BUDGET=12000     # token budget for the conversation portion
# GROKBOT2_KEEP_RECENT=8            # newest messages always sent word-for-word
# GROKBOT2_COMPACTION_MODEL=gemini-2.5-flash   # summarising is bulk reading, not reasoning

# ── System prompt ─────────────────────────────────────────────────────────
# By default the backend uses the ORIGINAL Grok Bot prompt, ported from the box host
# bundle (src/prompt-base.ts, ~4.9k tokens/turn — regenerate with scripts/build-prompt.mjs).
# It is what makes the app answer in the original's voice: reply-first, prose not
# bullet lists, its rules for when to ask a decision.
# Set to "short" for the small hand-written prompt when latency matters more than voice.
# GROKBOT2_PROMPT=short

# ── Web tools (no box, no API key) ────────────────────────────────────────
# web_search and web_fetch are the only two tools in the original's set that need
# neither, so they are always offered. Search defaults to DuckDuckGo's HTML endpoint;
# point GROKBOT2_SEARCH_URL at a real API when you have one — HTML scraping breaks
# whenever the page changes.
# GROKBOT2_WEB_TIMEOUT_MS=20000

# ── Agent memory ──────────────────────────────────────────────────────────
# Stored on the box OUTSIDE the tool sandbox (/root/grok-memory by default), so a stray
# rm -rf in the workspace cannot wipe what the agent has learned. Injected into the
# prompt's context tier every turn — a memory the agent must remember to read is one it
# usually does not read.
# GROKBOT2_MEMORY_BUDGET=4000   # characters of memory allowed into the prompt
# GROKBOT2_MEMORY_MAX=40        # entries kept per bot; oldest-updated evicted first

# ── MCP servers ───────────────────────────────────────────────────────────
# Declared in a repo-root .mcp.json (gitignored — it holds live tokens), same shape
# Claude Code and Cursor use:
#   { "mcpServers": { "github": { "command": "npx", "args": [...], "env": {...} } } }
# Unset/empty ⇒ get_mcp_tools and call_mcp_tool are not offered to the model at all.
# GROKBOT2_MCP_CONFIG=/path/to/.mcp.json     # override the location

# ── Independent UI (Phase 7) ──────────────────────────────────────────────
# `pnpm web` serves apps/grokbot-web on :5173 and proxies /v1 to this backend.
# `infra/scripts/run-web.ps1` opens that UI and never spawns Grok Bot.exe.
# Dual-run with the stock app: docs/dual-run.md

# ── Box SSH (for infra/scripts/box-tunnel.ps1) ────────────────────────────
# Keeps 127.0.0.1:9223 pointed at the box's Chrome DevTools so browser tools work.
#   infra\scripts\box-tunnel.ps1 -Install     # run at logon, reconnects on drop
#   infra\scripts\box-tunnel.ps1 -Uninstall
# GROKBOT2_BOX_SSH=root@YOUR_BOX_HOST:22
# GROKBOT2_BOX_SSH_KEY=id_ed25519            # name under ~/.ssh
