{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm build)",
      "Bash(pnpm backend)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm --filter*)",
      "Bash(node --check:*)",
      "Bash(npx tsx:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
