# deps / build
node_modules/
dist/
.turbo/
*.tsbuildinfo

# secrets — NEVER commit
.env
.env.local
# Bản sao lưu và bản nháp của .env cũng mang đúng những khoá ấy, mà hai dòng trên không bắt được:
# đo ngày 2026-08-29 thì `.env.bak-2026-08-28` (35 dòng) và `services/grokbot-backend/._env.mts`
# (15 dòng) đều nằm trần trong repo, mỗi file vài dòng có dạng khoá. Một `git add .` là đưa lên hết.
.env.*
!.env.example
._env*
*-key.txt
pool-key.txt
anthropic-key.txt
# The patterns above are all `*-key.txt`-shaped, and a real key sat in `poolkey.tmp` for days
# because that name matches none of them: no hyphen, wrong extension. Ignore by SHAPE OF THE
# NAME as well as by exact name, and treat every scratch file as a possible key carrier.
poolkey*
*key*.tmp
*.tmp
*.key
*.pem
secrets.json

# Third-party agent framework read/reused by P6-P7 (see docs/execution-roadmap.md §9, §11).
# 144 MB across 9,521 files, MIT (Nous Research) — obtained separately, not vendored here:
# committing it would dwarf this repo and mix someone else's history into ours.
hermes-agent-main/

# logs / scratch
*.log
spike-log.txt
*.png

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# local backend state (bots, transcripts, settings)
.data/

# Bearer token for the box exec daemon — never commit.
box-token.txt
.mcp.json

# the stock Grok Bot app, kept locally for prompt extraction — never committed
Grok Bot/

# ROADMAP DoD #5 / risk R5 — a patched client must never leave this machine.
# Observation is not enforcement: the tree was clean, but nothing stopped an `git add -f`-free
# accident either. These make it explicit rather than lucky.
*.asar
*.asar.disabled-by-grokbot2
*.asar.unpacked/
resources/app/
grokbot-fe-extracted/

# Mẩu bundle của hãng lấy ra khi dịch ngược, và script dò dùng một lần.
# 155 file `_tmp-*` đã từng bị commit (170 KB, 126 file .txt là trích đoạn bundle minify) —
# vi phạm chính luật của dự án: docs/legal.md và ROADMAP R5 cấm commit bundle của hãng.
# `.gitignore` trước đó chỉ chặn `*.asar`, không chặn mẩu đã trích ra.
services/grokbot-backend/scripts/_tmp-*

# Plugin catalog — may hold MCP server tokens in `env`. The .example is the committed template.
plugin-registry.json

# Speech-to-text engine: a local venv with the faster-whisper stack (~290MB) plus a model cache.
# Recreate with:  python -m venv .venv-stt && .venv-stt/Scripts/pip install faster-whisper
.venv-stt/

# Bundle giải nén của NHÀ PHÁT HÀNH — không bao giờ vào repo này.
#
# CLAUDE.md đã nói "decompiled bundle (reference only, not in this repo)", nhưng 31/08 phát hiện
# `docs/extracted/_latest-asar` nằm ngay trong cây làm việc: 16 MB mã của hãng, chưa commit và
# cũng chưa ignore — tức chỉ cách một lần `git add -A` là vào lịch sử vĩnh viễn.
#
# Nó vẫn hữu ích để ĐO (mọi phát hiện về cờ tính năng, askpass, hợp đồng lệnh đều đọc từ đó), nên
# không xoá — chỉ chặn không cho commit. Muốn dựng lại: giải nén app.asar của bản đang cài.
docs/extracted/_latest-asar/
