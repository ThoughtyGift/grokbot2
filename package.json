{
  "name": "grokbot2",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted backend for the Grok Bot desktop agent — points the stock frontend at your own Claude pool (admin.halcion.vn).",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "backend": "pnpm --filter @grokbot2/computer --filter @grokbot2/runtime --filter @grokbot2/ops --filter @grokbot2/backend --parallel dev",
    "dev:app": "powershell -ExecutionPolicy Bypass -File infra/scripts/run.ps1",
    "web": "pnpm --filter @grokbot2/web dev",
    "runtime": "pnpm --filter @grokbot2/runtime dev",
    "computer": "pnpm --filter @grokbot2/computer dev",
    "ops": "pnpm --filter @grokbot2/ops dev",
    "phase:gate": "node services/grokbot-backend/scripts/phase-gate.mjs",
    "phase:advance": "node services/grokbot-backend/scripts/phase-gate.mjs --advance",
    "test:avatar": "node services/grokbot-backend/scripts/e2e-avatar.mjs",
    "test:avatar-ui": "node services/grokbot-backend/scripts/e2e-avatar-ui.mjs",
    "test:reaction": "node services/grokbot-backend/scripts/e2e-reaction.mjs",
    "e2e:history": "node services/grokbot-backend/scripts/run-history.mjs",
    "api:gen": "node services/grokbot-backend/scripts/gen-openapi.mjs",
    "code:size": "node services/grokbot-backend/scripts/code-size.mjs",
    "self-xray": "node services/grokbot-backend/scripts/self-xray.mjs",
    "docs:check": "node services/grokbot-backend/scripts/docs-check.mjs",
    "ui:xray": "node services/grokbot-backend/scripts/x-ray.mjs",
    "ui:diff": "node services/grokbot-backend/scripts/ui-diff.mjs",
    "ui:shots": "node services/grokbot-backend/scripts/ui-shots.mjs --open",
    "soak": "node services/grokbot-backend/scripts/soak-day.mjs",
    "soak:status": "node services/grokbot-backend/scripts/soak-day.mjs --status",
    "test:host-settings": "node services/grokbot-backend/scripts/e2e-host-settings.mjs",
    "measure:resize": "node services/grokbot-backend/scripts/measure-web-resize.mjs",
    "measure:pane": "node services/grokbot-backend/scripts/measure-pane-nav.mjs",
    "measure:consistency": "node services/grokbot-backend/scripts/measure-ui-consistency.mjs",
    "measure:transcript": "node services/grokbot-backend/scripts/measure-transcript-cost.mjs",
    "measure:transcript-scroll": "node services/grokbot-backend/scripts/measure-transcript-scroll.mjs",
    "measure:shot": "node services/grokbot-backend/scripts/measure-shot.mjs",
    "test:routines": "node services/grokbot-backend/scripts/e2e-routines.mjs",
    "measure:routines": "node services/grokbot-backend/scripts/measure-routines-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "knip": "^6.32.2",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
