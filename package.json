{
  "name": "grokbot2",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted backend for the Grok Bot desktop agent — points the stock frontend at your own Claude pool (admin.halcion.vn).",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "backend": "pnpm --filter @grokbot2/backend dev"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
